# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Force LF for Docker, scripts, config, and source files
Dockerfile text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.prisma text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
.env* text eol=lf
